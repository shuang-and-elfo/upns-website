---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ENROLLMENT_DATA } from "../content/enrollment";
import { SITE_CONFIG } from "../content/site";
import SectionIntro from "../components/SectionIntro.astro";
import FloatingIllustration from "../components/FloatingIllustration.astro";
---

<BaseLayout
  title="Apply to UPNS & Tuition"
  description="Apply to University Parents Nursery School (UPNS) in Los Angeles. Review our 3-step application process, tuition schedule, eligibility, what to bring, and FAQs."
>
  {/* HERO HEADER */}
  <header class="apply-hero">
    <FloatingIllustration src="school.png" position="top-right" size="lg" rotate={8} />
    <FloatingIllustration src="sun.png" position="bottom-left" size="md" rotate={-10} />
    <div class="container">
      <div class="hero-text-centered">
        <h1 class="page-title">Joining our preschool family.</h1>
        <p class="page-desc">
          We welcome families of UCLA students, staff, and faculty, as well as non-UCLA affiliated Los Angeles community families. Below is everything you need to know about applying, tuition, waitlist timing, and daily classroom preparation.
        </p>
      </div>
    </div>
  </header>

  {/* 3-STEP APPLICATION PROCESS */}
  <section class="steps-section" aria-labelledby="steps-heading">
    <FloatingIllustration src="flower.png" position="bottom-right" size="md" rotate={10} />
    <div class="container">
      <SectionIntro
        badge="How to Apply"
        title="3 Simple Steps to Enroll"
        subtitle="Please review these steps to begin your family's application with UPNS."
        align="center"
      />

      <div class="steps-stack">
        <article class="step-card">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Schedule a Campus Tour (Recommended)</h3>
            <p>
              Before applying, we invite you to tour our school to experience our classrooms and meet our teachers. Please call <strong>{SITE_CONFIG.contact.phone}</strong> to make a morning appointment.
            </p>
            <div class="step-cta-row">
              <a href="/visit/" class="step-link-btn outline">
                <span>Plan Your Visit</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <article class="step-card highlight-step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Submit Your Online Application</h3>
            <p>
              Complete our direct online application on Playground to join our waiting list and create your family profile.
            </p>
            <div class="step-cta-row">
              <a
                href="https://app.tryplayground.com/listings/pHGaQQmCye08bdPbfZWx"
                target="_blank"
                rel="noopener noreferrer"
                class="step-link-btn primary"
              >
                <span>Apply Online on Playground</span>
                <span class="btn-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>

        <article class="step-card">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>Acceptance & Enrollment Notification</h3>
            <p>
              When a space becomes available, we will notify you by phone. Within 1 week of notification, you must confirm your intent to enroll. Within 2 weeks, complete enrollment forms and submit the one-time $500 enrollment fee ($250 Registration + $250 Security Deposit).
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* TUITION & FEES TABLE */}
  <section class="tuition-section" aria-labelledby="tuition-heading">
    <FloatingIllustration src="ladybug2.png" position="center-left" size="md" rotate={-12} />
    <div class="container tuition-single-col">
      <SectionIntro
        badge="Tuition & Fees"
        title="Program options & transparent fee schedule."
        subtitle="As a non-profit cooperative, our tuition covers teacher salaries and daily classroom operations. Fundraisers and parent workdays help keep our tuition reasonable."
        align="center"
      />

      <div class="tuition-cards">
        {ENROLLMENT_DATA.tuitionSchedule.map((item) => (
          <div class="tuition-card">
            <div class="card-header">
              <h3>{item.program}</h3>
              <span class="tuition-rate">{item.monthlyTuition}</span>
            </div>
            <p class="card-schedule">{item.schedule}</p>
            <p class="card-notes">{item.notes}</p>
          </div>
        ))}
      </div>

      <div class="waitlist-card">
        <h3>Waitlist Priority</h3>
        <p>
          All our programs have a waiting list. Your child's position depends on (1) when you applied, and (2) the date your child is ready to start. Families may decline a position and remain on the waiting list without losing priority.
        </p>
      </div>
    </div>
  </section>

  {/* WHAT TO BRING & POTTY TRAINING POLICY */}
  <section class="bring-section" aria-labelledby="bring-heading">
    <div class="container bring-grid">
      <div class="bring-col">
        <h2>What to Bring to School</h2>
        <p class="bring-intro">
          UPNS provides all classroom learning materials, art supplies, and sensory tools. Please make sure all personal items are clearly labeled with your child's name:
        </p>
        <ul class="bring-list">
          {ENROLLMENT_DATA.whatToBring.map((item) => (
            <li>
              <span class="check-icon">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bring-col not-bring-col">
        <h2>What NOT to Bring</h2>
        <p class="bring-intro">
          To keep our classrooms safe, peaceful, and inclusive, please leave the following items at home:
        </p>
        <ul class="bring-list">
          {ENROLLMENT_DATA.whatNotToBring.map((item) => (
            <li>
              <span class="cross-icon">✕</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="potty-reminder">
          <h3>🚽 Potty Training Policy</h3>
          <p>{ENROLLMENT_DATA.eligibility.pottyTraining}</p>
        </div>
      </div>
    </div>
  </section>

  {/* FREQUENTLY ASKED QUESTIONS */}
  <section class="faq-section" aria-labelledby="faq-heading">
    <div class="container">
      <SectionIntro
        badge="Admissions FAQ"
        title="Frequently Asked Questions"
        subtitle="Honest answers to common questions about admissions, waitlists, and co-op expectations."
        align="center"
      />

      <div class="faq-list">
        {ENROLLMENT_DATA.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span>{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="faq-a">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CONTACT HELP BANNER */}
  <section class="help-section">
    <div class="container">
      <div class="help-banner">
        <h2>Need help with your application?</h2>
        <p>
          Call us at <strong>(310) 397-2735</strong> or email <strong>upns@ucla.edu</strong> and our Office Administrator will be glad to assist you.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .apply-hero {
    padding: 3.5rem 0 4.5rem;
    background: linear-gradient(180deg, var(--color-paper-white) 0%, var(--color-cream) 100%);
  }

  .hero-text-centered {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .page-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .page-desc {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  /* 4-Step Process Section */
  .steps-section {
    padding: 5.5rem 0;
    position: relative;
    overflow: hidden;
  }

  .steps-stack {
    max-width: 860px;
    margin: 2rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .step-card {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: 24px;
    padding: 2.25rem 2.5rem;
    box-shadow: var(--shadow-natural);
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-tomato);
    color: #ffffff;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-content {
    flex-grow: 1;
  }

  .step-content h3 {
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
  }

  .highlight-step {
    border-color: rgba(224, 86, 36, 0.4);
    background: linear-gradient(180deg, #ffffff 0%, #fffdfa 100%);
    box-shadow: 0 8px 24px rgba(224, 86, 36, 0.08);
  }

  .step-cta-row {
    margin-top: 1rem;
  }

  .step-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .step-link-btn.primary {
    background: var(--color-tomato);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(224, 86, 36, 0.25);
  }

  .step-link-btn.primary:hover {
    background: #cc4518;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(224, 86, 36, 0.35);
  }

  .step-link-btn.outline {
    background: transparent;
    color: var(--color-moss, #35483c);
    border: 2px solid var(--color-moss, #35483c);
  }

  .step-link-btn.outline:hover {
    background: var(--color-moss, #35483c);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-arrow {
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .step-link-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Tuition Section */
  .tuition-section {
    padding: 5.5rem 0;
    background: var(--color-paper-white);
    position: relative;
    overflow: hidden;
  }

  .tuition-single-col {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .tuition-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tuition-card {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: var(--shadow-natural);
    text-align: center;
  }

  .card-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .card-header h3 {
    font-size: 1.45rem;
    margin: 0;
  }

  .tuition-rate {
    font-weight: 700;
    color: var(--color-tomato);
    background: #ffede8;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    display: inline-block;
  }

  .card-schedule {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .card-notes {
    font-size: 0.98rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .waitlist-card {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: var(--shadow-natural);
    text-align: center;
  }

  .waitlist-card h3 {
    font-size: 1.3rem;
    margin: 0 0 0.6rem;
  }

  .waitlist-card p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* What to Bring */
  .bring-section {
    padding: 5.5rem 0;
  }

  .bring-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem;
  }

  .bring-col h2 {
    font-size: 1.75rem;
    margin: 0 0 1rem;
  }

  .bring-intro {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .bring-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .bring-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.98rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .check-icon {
    color: var(--color-leaf-green);
    font-weight: 700;
  }

  .cross-icon {
    color: var(--color-tomato);
    font-weight: 700;
  }

  .potty-reminder {
    background: var(--color-cream);
    border-left: 4px solid var(--color-yellow);
    padding: 1.25rem 1.5rem;
    border-radius: 0 16px 16px 0;
    margin-top: 2rem;
  }

  .potty-reminder h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }

  .potty-reminder p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* FAQ Section */
  .faq-section {
    padding: 5rem 0;
    background: var(--color-paper-white);
  }

  .faq-list {
    max-width: 820px;
    margin: 2rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #ffffff;
    border: 2px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--color-terracotta, #c66249);
    background: transparent;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item:hover .faq-icon {
    background: var(--color-cream, #fff9ee);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-a {
    padding: 0 1.5rem 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .faq-a p {
    margin: 0;
  }

  /* Help Section */
  .help-section {
    padding: 2rem 0 5rem;
  }

  .help-banner {
    background: var(--color-text);
    color: #ffffff;
    border-radius: 28px;
    padding: 2.5rem 3rem;
    text-align: center;
  }

  .help-banner h2 {
    color: #ffffff;
    font-size: 1.85rem;
    margin: 0 0 0.5rem;
  }

  .help-banner p {
    color: #cedad1;
    font-size: 1.08rem;
    margin: 0;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .tuition-grid,
    .bring-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.3rem;
    }
    .step-card {
      flex-direction: column;
      padding: 1.75rem;
    }
  }
</style>
